{
  "name": "meetspace-desktop",
  "version": "0.1.4-beta",
  "private": true,
  "description": "MeetSpace desktop with the supplied Windows design — test build",
  "author": "MeetSpace",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/entry.js",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:main",
    "test": "node --test tests/*.test.cjs",
    "pretest:smoke": "npm run build",
    "test:smoke": "electron tests/electron-smoke.cjs",
    "pretest:integration": "npm run build:main",
    "test:integration": "node tests/integration-runner.cjs",
    "pretest:ui": "npm run build",
    "test:ui": "node tests/electron-ui-runner.cjs",
    "pretest:probe": "npm run build:main",
    "test:probe": "electron tests/electron-native-probe.cjs",
    "test:headers": "electron tests/electron-header-semantics.cjs",
    "pretest:native": "npm run build:main",
    "test:native": "node tests/native-shell-runner.cjs",
    "pretest:product": "npm run build",
    "test:product": "node tests/electron-product-runner.cjs",
    "pretest:assets": "npm run build:main",
    "test:assets": "electron tests/assets-electron.cjs",
    "pretest:sfu": "npm run build:main",
    "test:sfu": "node tests/sfu-runner.cjs",
    "pretest:media": "npm run build:main",
    "test:media": "node tests/media-runner.cjs",
    "test:profile": "node tests/stage07-profile-runner.cjs",
    "test:lifecycle": "node --expose-gc tests/native-lifecycle.cjs",
    "test:media-lifecycle": "node tests/stage07-media-runner.cjs",
    "build:main": "tsc",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "electron .",
    "pack:win:x64": "node scripts/package.mjs x64",
    "pack:win:arm64": "node scripts/package.mjs arm64",
    "pack:win": "node scripts/package.mjs all",
    "pack:linux:x64": "node scripts/package-linux.mjs x64",
    "pack:linux:arm64": "node scripts/package-linux.mjs arm64",
    "verify:linux": "node scripts/verify-linux-artifacts.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "release": "node scripts/release.mjs",
    "pretest:ssh": "npm run build",
    "test:ssh": "node tests/electron-ssh-runner.cjs",
    "pretest:platform": "npm run build",
    "test:platform": "node tests/platform-electron-runner.cjs"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/ssh2": "1.15.6",
    "@types/ws": "8.18.2",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "ssh2": "1.17.0",
    "ws": "8.22.0"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "4.1.3"
    }
  }
}
